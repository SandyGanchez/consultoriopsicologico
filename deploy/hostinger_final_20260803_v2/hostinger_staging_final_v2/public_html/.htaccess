Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Front controller (compatible con subcarpeta Laragon y dominio raíz Hostinger).
    # No forzar HTTPS aquí: en local se usa HTTP; en producción va el .htaccess del paquete.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Bloquear archivos sensibles si existieran por error en el document root.
<FilesMatch "(?i)^(\.env|composer\.(json|lock)|.*\.(sql|md|log|bak))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
