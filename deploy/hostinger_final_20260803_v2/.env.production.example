# =============================================================================
# PsicoMatch — ejemplo de entorno de PRODUCCIÓN (paquete v2)
# Dominio: https://consultoriospsicologicospsicomatch.com
#
# Copiar este archivo como `.env` en el directorio PRIVADO del dominio
# (junto a app/, vendor/, routes/). NUNCA dentro de public_html.
# No colocar secretos reales en este archivo de ejemplo.
# =============================================================================

APP_NAME="PsicoMatch"
APP_ENV=production
APP_DEBUG=0
APP_URL=https://consultoriospsicologicospsicomatch.com
APP_TIMEZONE=America/Mexico_City

# Aviso de privacidad (versión publicada)
PRIVACY_NOTICE_VERSION=1.0
PRIVACY_NOTICE_DATE=2026-08-02
# Opcional: correo específico de privacidad (si difiere del correo del consultorio)
# PRIVACY_CONTACT_EMAIL=

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

MAIL_HOST=
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=PsicoMatch

# 1 = no envía SMTP de citas; marca flujo de prueba.
# Mantener en 1 durante el primer humo de producción.
# Cambiar a 0 SOLO después de validar SMTP con cuentas de prueba.
MAIL_CITA_DRY_RUN=1

SESSION_SECURE_COOKIE=1
SESSION_HTTP_ONLY=1
SESSION_SAME_SITE=Lax
