# =============================================================================
# PsicoMatch — ejemplo de entorno (desarrollo / referencia)
# Copiar a .env y completar valores reales. NUNCA subir .env al repositorio.
# =============================================================================

APP_NAME="PsicoMatch"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/consultorio_psicologico/public
APP_TIMEZONE=America/Mexico_City

PRIVACY_NOTICE_VERSION=1.0
PRIVACY_NOTICE_DATE=2026-08-02

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=consultorio_psicologico
DB_USER=root
DB_PASS=

MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=PsicoMatch

# Opcional. 1 = conectar SMTP por IPv4 resuelta en runtime (gethostbyname),
# manteniendo peer_name = MAIL_HOST para verificación TLS. Predeterminado 0.
# MAIL_FORCE_IPV4=0

# Timeouts SMTP (segundos). Se validan en rango seguro en MailService.
# MAIL_TIMEOUT: 5–60 (predeterminado 15)
# MAIL_TIMELIMIT: 5–120 (predeterminado 20)
MAIL_TIMEOUT=15
MAIL_TIMELIMIT=20

# Cola de correos de cita (CLI). En pruebas locales:
# MAIL_CITA_DRY_RUN=1
# Anticipación del recordatorio en horas (entero 1–168; predeterminado 24).
# No aceptar este valor por GET/POST.
# CITA_RECORDATORIO_HORAS=24

SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax
