# =============================================================================
# PsicoMatch — ejemplo de entorno de PRODUCCIÓN
# Dominio canónico: https://consultoriospsicologicospsicomatch.com
# Copiar a .env en el servidor (NUNCA dentro de public_html si usas private/).
# No colocar secretos reales en este archivo de ejemplo.
# =============================================================================

APP_NAME="PsicoMatch"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://consultoriospsicologicospsicomatch.com
APP_TIMEZONE=America/Mexico_City

PRIVACY_NOTICE_VERSION=1.0
PRIVACY_NOTICE_DATE=2026-08-02
# Opcional: correo específico de privacidad (si difiere del correo del consultorio)
# PRIVACY_CONTACT_EMAIL=

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

MAIL_HOST=
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=PsicoMatch

# Timeouts SMTP (segundos). Se validan en rango seguro en MailService.
# MAIL_TIMEOUT: 5–60 (predeterminado 15)
# MAIL_TIMELIMIT: 5–120 (predeterminado 20)
MAIL_TIMEOUT=15
MAIL_TIMELIMIT=20

# Cola de correos/recordatorios de cita (procesador CLI privado).
# MAIL_CITA_DRY_RUN=1
# CITA_RECORDATORIO_HORAS=24

SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax
